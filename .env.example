# Public base URL of the deployed site, no trailing slash.
# Used for metadata, Open Graph, canonical URLs, sitemap, and robots.
# Local: http://localhost:3000 — Production (Vercel env): https://harshvardhannimesh.com
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Phase 3: AI scheduling assistant (Contact page) ---

# Required for the scheduler to run. Without it the chat returns a 503 and the
# rest of the Contact page still works.
ANTHROPIC_API_KEY=""

# Abuse protection for the public Claude-backed endpoints. Optional locally;
# set both on the production deployment. Create a free DB at upstash.com.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Booking notifications. Without RESEND_API_KEY a confirmed booking is only
# logged server-side (the visitor still gets calendar links). Get a key at
# resend.com. SCHEDULE_FROM_EMAIL must be on a Resend-verified domain; the
# default onboarding@resend.dev only delivers to the Resend account owner.
RESEND_API_KEY=""
SCHEDULE_NOTIFY_EMAIL=""          # defaults to siteConfig.email
SCHEDULE_FROM_EMAIL=""            # e.g. "Portfolio <scheduler@yourdomain.com>"
